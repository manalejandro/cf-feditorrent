{
  "name": "cf-feditorrent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "lint": "eslint",
    "preview": "vite build && vite preview",
    "deploy": "vinext-cloudflare deploy",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 execute cf-feditorrent --remote --file=lib/db/schema.sql",
    "db:drop": "wrangler d1 execute cf-feditorrent --remote --command='DROP TABLE IF EXISTS sessions; DROP TABLE IF EXISTS delivery_failures; DROP TABLE IF EXISTS notifications; DROP TABLE IF EXISTS activities; DROP TABLE IF EXISTS follows; DROP TABLE IF EXISTS objects; DROP TABLE IF EXISTS torrents; DROP TABLE IF EXISTS actors;'"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vinext/cloudflare": "^1.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "^4.148.0"
  },
  "type": "module"
}
